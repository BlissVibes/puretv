<?xml version="1.0" encoding="utf-8"?>
<!--
  PureTV for Twitch — phone/tablet manifest (SECTION 06.1)
  Sideload distribution only — no Play Store metadata.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates: download the new APK and hand it to the system installer
         (Section 09). The user still grants a one-time "install unknown apps"
         consent the first time; this permission is what lets us ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Background play (issue #27): a media-playback foreground service keeps a
         stream going after the app leaves the screen, its notification carries
         the controls (asked for at runtime on Android 13+), and the wake lock
         lets ExoPlayer keep the CPU and Wi-Fi up with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (API 30+): the updater resolves the "install unknown
         apps" consent screen before offering a button for it, and resolution is
         filtered like any other cross-package lookup. Without this the match can
         come back empty on some builds and a device that HAS the screen gets the
         written directions instead. -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
    </queries>

    <application
        android:name=".PureTvApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureTv">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.PureTv">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller session callbacks for the in-app updater. Not
             exported: it's targeted by an explicit PendingIntent from our own
             process, and it launches the system's install-confirm screen. -->
        <receiver
            android:name=".update.AndroidUpdateInstallReceiver"
            android:exported="false" />

        <!-- Media session for background play. Exported with the media3 action
             so system media controls, Bluetooth and the lock screen can reach the
             session; media3 decides when it runs in the foreground. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
